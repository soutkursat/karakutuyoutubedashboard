# Supabase → Project Settings → API (veya "Connect") ekranından kopyala.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon public" ya da "publishable" anahtar (tarayıcıda görünmesi güvenlidir)
VITE_SUPABASE_ANON_KEY=

# SADECE SUNUCU (Vercel) — asla VITE_ ile başlatma, asla paylaşma!
# Yönetici panelinden öğrenci ekleme/silme/şifre sıfırlama için gerekli.
SUPABASE_SERVICE_ROLE_KEY=

# Google Takvim + otomatik Meet (SADECE SUNUCU — Vercel)
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# İsteğe bağlı: site adresin (ör. https://karakutuyoutubedashboard.vercel.app). Boşsa istek adresi kullanılır.
APP_URL=
