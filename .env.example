# Supabase → Project Settings → API (veya "Connect") ekranından kopyala.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon public" ya da "publishable" anahtar (tarayıcıda görünmesi güvenlidir)
VITE_SUPABASE_ANON_KEY=

# SADECE SUNUCU (Vercel) — asla VITE_ ile başlatma, asla paylaşma!
# Yönetici panelinden öğrenci ekleme/silme/şifre sıfırlama için gerekli.
SUPABASE_SERVICE_ROLE_KEY=

# Google Takvim + otomatik Meet (SADECE SUNUCU — Vercel)
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# İsteğe bağlı: site adresin (ör. https://karakutuyoutubedashboard.vercel.app). Boşsa istek adresi kullanılır.
APP_URL=

# E-posta (Natro e-posta hesapları, SMTP) — SADECE SUNUCU (Vercel), asla VITE_ ile başlatma.
# Natro panelinde iki e-posta hesabı aç: sistem@ (otomatik bildirimler) ve kursat@ (senin e-postaların).
# Sunucu adresini Natro'nun e-posta ayarları sayfasından kontrol et (genelde mail.alanadin.com).
SMTP_HOST=mail.karakutuyoutube.com
# 465 = SSL (önerilir), 587 = STARTTLS
SMTP_PORT=465
SMTP_SYSTEM_USER=sistem@karakutuyoutube.com
SMTP_SYSTEM_PASS=
SMTP_ADMIN_USER=kursat@karakutuyoutube.com
SMTP_ADMIN_PASS=
